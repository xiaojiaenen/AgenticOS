# AgenticOS 内网离线部署环境变量（外部 MySQL + 外部 Redis）
# 用法：cp .env.offline.example .env 然后按注释填写

# ─── 外部数据库（既有 MySQL 8，库与账号需提前建好）──
# 建库语句见 OFFLINE-DEPLOY.md 第四节（必须 utf8mb4）
DATABASE_URL=mysql+pymysql://agenticos:<密码>@<MySQL主机>:3306/agenticos

# ─── 外部缓存（既有 Redis，普通版即可，不需要 Redis Stack）──
REDIS_URL=redis://<Redis主机>:6379/0
REDIS_CLUSTER=false

# ─── 认证密钥（务必用随机值，两个必须不同）──
# openssl rand -hex 32
AUTH_SECRET_KEY=
EXTERNAL_SYSTEM_ENCRYPTION_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=10080

# ─── LLM 兜底配置（配了「管理后台 → AI 提供商」后此项不参与）──
OPENAI_API_KEY=placeholder
OPENAI_BASE_URL=http://<内网模型网关>/v1
OPENAI_MODEL=<模型名>

# ─── 前端访问地址（跨域白名单 + 邮件链接）──
CORS_ALLOW_ORIGINS=http://<部署机IP>:10008

# ─── 本地嵌入模型（内网必配）──
# bge-m3：1024 维，效果最好，约 2.3GB / 内存约 1.5GB
# 内存紧张可用：BAAI/bge-base-zh-v1.5（768 维，400MB）
KNOWLEDGE_EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
KNOWLEDGE_EMBEDDING_LOCAL_DIMENSIONS=1024

# ─── 端口 ───
BACKEND_PORT=10007
FRONTEND_PORT=10008

# ─── LDAP（也可在管理后台配置；这里是首次引导）──
LDAP_ENABLED=false
LDAP_AUTO_CREATE_USERS=true
# 公司邮箱域：用于剥离登录输入里的 @后缀、以及邮箱凭据自动绑定
LDAP_EMAIL_DOMAIN=

# ─── 系统通知邮件（验证码、任务完成通知）──
NOTIFY_EMAIL_ADDRESS=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_SSL=true

# ─── 环境 ───
ENVIRONMENT=production
