# 数据库（需要提前创建好数据库和用户）
DATABASE_URL=mysql+pymysql://user:password@host:3306/agenticos

# OpenAI 配置（必填）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

# 认证（务必生成自己的密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"）
AUTH_SECRET_KEY=ZMXl1bBOksaCc0U5ZbQivApJShINT348H03ny_5MRlvDURsAzGN_2eNFKTS9ZNY0
AUTH_TOKEN_EXPIRE_MINUTES=10080

# 环境
ENVIRONMENT=production
CORS_ALLOW_ORIGINS=http://localhost:3001

# Skill 存储
SKILL_STORAGE_DIR=./data/skills

# 基础镜像仓库（构建时拉取 python/nginx 等）
BASE_REGISTRY=172.73.0.156:85

# 应用镜像仓库（构建产物推送到哪）
IMAGE_REGISTRY=172.73.0.156:85

# 内网 PyPI 镜像源（backend 构建时使用）
