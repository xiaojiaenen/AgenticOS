# 数据库（需要提前创建好数据库和用户）
DATABASE_URL=mysql+pymysql://user:password@host:3306/agenticos

# OpenAI 配置（必填）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

# 认证（务必生成自己的密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"）
# 【必填】未配置时后端会回退到 data/.auth_secret 持久化文件，但仍强烈建议显式配置
AUTH_SECRET_KEY=change-me-generate-your-own-with-python-c-import-secrets-print-secrets-token_urlsafe-48
# Access Token 有效期（分钟），config.py 默认 1440（24 小时）
AUTH_TOKEN_EXPIRE_MINUTES=10080
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_BLOCK_SECONDS=900

# HITL 人工审批工作流
HITL_ENABLED=true
# 需要审批的工具（逗号分隔；留空则使用 config 默认 file_to_md,run_skill_python_script）
HITL_REQUIRE_APPROVAL_TOOLS=file_to_md,run_skill_python_script
# 审批等待超时（秒），超时自动拒绝
HITL_TIMEOUT_SECONDS=300

# 凭据代理 API 内部令牌（供爬虫平台等内部系统调用；留空则禁用令牌校验）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIAL_PROXY_TOKEN=

# LDAP 认证网关（内网 LDAP 代理，启用后自动禁用密码登录和注册）
LDAP_ENABLED=false
# LDAP 登录时自动创建本地用户（关闭后需管理员手动创建）
LDAP_AUTO_CREATE_USERS=false
LDAP_GATEWAY_URL=
LDAP_EMAIL_DOMAIN=gree.com.cn
LDAP_EMAIL_IMAP_HOST=
LDAP_EMAIL_IMAP_PORT=993
LDAP_EMAIL_SMTP_HOST=
LDAP_EMAIL_SMTP_PORT=465

# ─── 记忆系统（分层蒸馏 + 混合检索；留空则使用 config 默认值） ───
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_RETRIEVAL_CHAR_BUDGET=2000
MEMORY_RETRIEVAL_TIMEOUT_MS=500
MEMORY_L2_AGGREGATE_TURNS=6
MEMORY_L3_PERSONA_TURNS=20
MEMORY_VECTOR_TOP_K=10
MEMORY_BM25_TOP_K=10
MEMORY_RRF_K=60

# ─── 本地嵌入模型（内网必配：留空 = 走远程 /embeddings，内网会失败） ───
# 记忆向量召回 + 知识库语义检索都走它，本地推理零 API 成本。
# bge-m3：1024 维，中英混排效果好，约 2.3GB（内存约 1.5GB）
# 轻量替代：BAAI/bge-base-zh-v1.5 = 768 维，约 400MB
KNOWLEDGE_EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
KNOWLEDGE_EMBEDDING_LOCAL_DIMENSIONS=1024

# 模型缓存目录（必须是可写卷；容器根文件系统只读）
HF_HOME=/app/data/hf-cache
# 内网无 HF 出口：留空并在 compose 里设离线开关（见 OFFLINE-DEPLOY.md）
HF_ENDPOINT=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 环境
ENVIRONMENT=production
CORS_ALLOW_ORIGINS=http://localhost:3001

# Redis（留空则使用内存 fallback，生产环境建议配置外部 Redis）
REDIS_URL=
REDIS_CLUSTER=false

# 外部系统凭据加密密钥（留空则从 AUTH_SECRET_KEY 派生）
EXTERNAL_SYSTEM_ENCRYPTION_KEY=

# 系统通知邮箱（用于验证码发送、任务完成通知、欢迎邮件）
NOTIFY_EMAIL_ADDRESS=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_SMTP_HOST=10.12.128.18
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_SSL=true
NOTIFY_TASK_MIN_SECONDS=120

# Skill 存储
SKILL_STORAGE_DIR=./data/skills

# 基础镜像仓库（构建时拉取 python/nginx 等）
BASE_REGISTRY=docker.io

# 应用镜像仓库（构建产物推送到哪）
IMAGE_REGISTRY=docker.io

# 内网 PyPI 镜像源（backend 构建时使用）
PYPI_MIRROR=https://pypi.org/simple

# 端口
BACKEND_PORT=10007
FRONTEND_PORT=10008
