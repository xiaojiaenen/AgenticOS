# 数据库（需要提前创建好数据库和用户）
DATABASE_URL=mysql+pymysql://user:password@host:3306/agenticos

# OpenAI 配置（必填）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

# 认证（务必生成自己的密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"）
AUTH_SECRET_KEY=ZMXl1bBOksaCc0U5ZbQivApJShINT348H03ny_5MRlvDURsAzGN_2eNFKTS9ZNY0
AUTH_TOKEN_EXPIRE_MINUTES=10080
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_BLOCK_SECONDS=900

# 环境
ENVIRONMENT=production
CORS_ALLOW_ORIGINS=http://localhost:3001

# Redis（留空则使用内存 fallback，生产环境建议配置外部 Redis）
REDIS_URL=
REDIS_CLUSTER=false

# 外部系统凭据加密密钥（留空则从 AUTH_SECRET_KEY 派生）
EXTERNAL_SYSTEM_ENCRYPTION_KEY=

# 系统通知邮箱（用于验证码发送、任务完成通知、欢迎邮件）
NOTIFY_EMAIL_ADDRESS=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_SSL=true
NOTIFY_TASK_MIN_SECONDS=120

# Skill 存储
SKILL_STORAGE_DIR=./data/skills

# 基础镜像仓库（构建时拉取 python/nginx 等）
BASE_REGISTRY=172.73.0.156:85

# 应用镜像仓库（构建产物推送到哪）
IMAGE_REGISTRY=172.73.0.156:85

# 内网 PyPI 镜像源（backend 构建时使用）
PYPI_MIRROR=https://pypi.org/simple

# 端口
BACKEND_PORT=10007
FRONTEND_PORT=10008
