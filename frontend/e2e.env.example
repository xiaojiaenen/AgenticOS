# E2E 测试所需环境变量。复制成 e2e.env 并填写，或直接在 shell 里 export。
# 注意：只有用到 agent.act / agent.assert 的用例需要模型 key；
# 纯 expect 断言的用例（例如 admin 分区冒烟）不需要任何 key 就能跑。

# 模型：OpenAI 兼容端点。默认 DeepSeek，内网可达。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 测试账号，需要是 admin 角色（否则 /admin 会跳走，登录用例的断言不成立）
E2E_TEST_EMAIL=tester@agenticos.dev
E2E_TEST_PASSWORD=

# 被测地址。开发时前端 dev server 在 3001，生产 Nginx 在 10008。
APP_URL=http://localhost:3001
