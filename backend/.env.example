APP_NAME=AgenticOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
# LLM 配置 - 走 sesame 网关(详见文件末尾 Sesame 网关集成 部分)
OPENAI_API_KEY=sk-sesame-xxxxxxxx
OPENAI_BASE_URL=http://<sesame地址>:<端口>/v1
OPENAI_MODEL=gpt-4o
AGENT_SYSTEM_PROMPT=你是 AgenticOS 的 AI 助手。
AGENT_MAX_STEPS=10
AGENT_MAX_TOKENS=65536
AGENT_PARALLEL_TOOL_CALLS=false
LLM_TIMEOUT=300
ASYNC_SUB_AGENTS_ENABLED=true
DATABASE_URL=sqlite:///../data/agenticos.db
SKILL_STORAGE_DIR=../data/skills
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESS_AFTER_TURNS=16
CONTEXT_KEEP_RECENT_TURNS=6
HITL_ENABLED=true
HITL_REQUIRE_APPROVAL_TOOLS=file_to_md,run_skill_python_script
HITL_TIMEOUT_SECONDS=300
AUTH_SECRET_KEY=change-this-to-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=10080
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_BLOCK_SECONDS=900

# Redis（留空则使用内存 fallback）
REDIS_URL=
REDIS_CLUSTER=false

# 外部系统凭据加密密钥（留空则从 AUTH_SECRET_KEY 派生）
EXTERNAL_SYSTEM_ENCRYPTION_KEY=

# LDAP 认证网关（内网 LDAP 代理，启用后自动禁用密码登录和注册）
LDAP_ENABLED=false
# LDAP 登录时自动创建本地用户（无需管理员预建；关闭后仍需管理员手动创建）
LDAP_AUTO_CREATE_USERS=false
LDAP_GATEWAY_URL=http://172.73.0.80:8888
LDAP_EMAIL_DOMAIN=gree.com.cn
LDAP_EMAIL_IMAP_HOST=
LDAP_EMAIL_IMAP_PORT=993
LDAP_EMAIL_SMTP_HOST=
LDAP_EMAIL_SMTP_PORT=465

# 系统通知邮箱（用于验证码发送、任务完成通知、欢迎邮件）
NOTIFY_EMAIL_ADDRESS=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_SSL=true
NOTIFY_TASK_MIN_SECONDS=120

# ─── 记忆系统（分层蒸馏 + 混合检索） ───
# 向量模型（复用 OPENAI_API_KEY/OPENAI_BASE_URL）
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
# 检索字符预算（防止记忆挤占主对话上下文）
MEMORY_RETRIEVAL_CHAR_BUDGET=2000
MEMORY_RETRIEVAL_TIMEOUT_MS=500
# L2 场景聚合触发轮次 / L3 画像更新触发轮次
MEMORY_L2_AGGREGATE_TURNS=6
MEMORY_L3_PERSONA_TURNS=20
# RRF 融合参数
MEMORY_VECTOR_TOP_K=10
MEMORY_BM25_TOP_K=10
MEMORY_RRF_K=60

# ─── Sesame 网关集成（LDAP 登录成功后自动同步账号密码到 sesame cookie 共享池） ───
# sesame 网关地址(如 http://10.0.0.1:8000)
SESAME_GATEWAY_URL=
# 内部共享密钥(必填,与 sesame 的 INTERNAL_API_KEY 保持一致)
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESAME_INTERNAL_TOKEN=
# sesame 中的 cookie 渠道 ID(可选,目前 sesame 侧已用 AI_ASSISTANT_CHANNEL_ID 管理)
SESAME_CHANNEL_ID=0
